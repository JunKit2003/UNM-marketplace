# Copy to .env. Everything has a working local default except where noted.

# --- Database ---
DB_NAME=unm
DB_USER=unm
DB_PASSWORD=unmpass
DB_ROOT_PASSWORD=rootpass

# --- API ---
NODE_ENV=development
# Required in production: at least 32 random characters (openssl rand -hex 32).
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef
# Reverse proxies in front of the api: 1 locally (web nginx), 2 on the VPS (host nginx + web nginx).
TRUST_PROXY=1
# Showcase mode: seed demo data, allow "Try the demo", nightly reset at 03:00 MYT.
SEED_DEMO=true
# Delay before demo sellers reply in chat (ms).
DEMO_REPLY_DELAY_MS=1500

# --- Production only (compose.prod.yaml) ---
# Image tag deployed by CI (commit SHA). Host address the web container listens on.
IMAGE_TAG=latest
WEB_BIND=127.0.0.1:8090
